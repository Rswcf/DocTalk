+    let started = false;
+    let finished = false;
+    let visible = true;
+    let raf = 0;
+    let t0: number | null = null;
+    let W = 0;
+    let H = 0;
+    let dpr = 1;
+    let offsetY = 0;
+    let words: Word[] = [];
+    let spans: Span[] = [];
+    let cited: { cx: number; cy: number; first: Span } | null = null;
+    let fonts = { body: '', title: '', badge: '' };
+    let colours = { ink: [128, 128, 128] as Rgb, evidence: [128, 128, 128] as Rgb, soft: [128, 128, 128] as Rgb };
